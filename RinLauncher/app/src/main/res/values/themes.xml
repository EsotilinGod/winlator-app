<resources>
    <style name="Theme.RinLauncher" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Muestra el fondo de pantalla del sistema detrás (el fondo animado de Rin, si está activo). -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@color/gold_dark</item>
        <item name="android:colorPrimary">@color/gold</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="Dialog.Rin" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/gold_dark</item>
    </style>
</resources>
